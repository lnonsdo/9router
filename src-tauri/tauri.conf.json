{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "9Router",
  "version": "0.5.50",
  "identifier": "com.9router.desktop",
  "build": {
    "beforeDevCommand": "pnpm run build && pnpm run dev:server",
    "devUrl": "http://127.0.0.1:20129/dashboard",
    "beforeBuildCommand": "pnpm run build:standalone",
    "frontendDist": "frontend-dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "9Router",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/icons/icon-512.png"
    ],
    "resources": {
      "../standalone-dist": "standalone"
    },
    "externalBin": [],
    "macOS": {
      "minimumSystemVersion": "11.0.0"
    },
    "category": "Utilities",
    "shortDescription": "9Router AI gateway desktop app"
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
